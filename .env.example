# Supabase Public API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Used exclusively by backend route handlers/webhooks for admin actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI KYC Provider (Smile ID / Prembly / Sumsub)
KYC_PROVIDER=smile_id
SMILE_ID_PARTNER_ID=your-partner-id
SMILE_ID_API_KEY=your-api-key
SMILE_ID_CALLBACK_URL=https://your-domain.com/api/kyc/webhook

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
